#!/usr/bin/env bash
# crewlead — the command line. Put it on your PATH once:
#
#   mkdir -p ~/.local/bin && ln -s /path/to/crewlead/bin/crewlead ~/.local/bin/crewlead
#
# Commands (repo defaults to the current directory):
#   crewlead init   [--labels] [--platform github|gitlab] [repo]   put the flow into a repository
#   crewlead update [--labels] [--platform github|gitlab] [repo]   bring it to this version of crewlead
#   crewlead check  [repo]                                         read-only: what is installed, what is missing
#   crewlead version
#
# init and update copy files from this crewlead folder into the repository
# (AGENTS.md, skills, .ai/flow, templates). The repository then works on its
# own: teammates and CI do not need crewlead. Run `crewlead update` after
# changing crewlead to bring a repository up to date.
set -euo pipefail

# Find this file's real folder, following the PATH symlink.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ "$self" == /* ]] || self="$dir/$self"
done
CREWLEAD_HOME="$(cd -P "$(dirname "$self")/.." && pwd)"
VERSION="$(cat "$CREWLEAD_HOME/VERSION")"

usage() { sed -n 2,15p "$self" | sed 's/^# \{0,1\}//'; }

# The repository argument: the one positional among the options.
repo_of() {
  local repo="" skip=0 a
  for a in "$@"; do
    if (( skip )); then skip=0; continue; fi
    case "$a" in
      --platform) skip=1 ;;
      -*) ;;
      *) repo="$a" ;;
    esac
  done
  echo "${repo:-.}"
}

installed_version() { cat "$1/.ai/flow/VERSION" 2>/dev/null || true; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  init)
    repo="$(repo_of "$@")"
    if [[ -n "$(installed_version "$repo")" ]]; then
      echo "already installed here (v$(installed_version "$repo")) — updating instead"
    fi
    [[ "$(repo_of "$@")" == . && " $* " != *" . "* ]] && set -- "$@" .
    exec "$CREWLEAD_HOME/lib/install.sh" "$@"
    ;;

  update)
    repo="$(repo_of "$@")"
    have="$(installed_version "$repo")"
    if [[ -z "$have" ]]; then
      echo "crewlead is not installed in $repo — run: crewlead init $repo" >&2; exit 1
    fi
    [[ "$have" != "$VERSION" ]] && echo "v$have → v$VERSION"
    [[ "$(repo_of "$@")" == . && " $* " != *" . "* ]] && set -- "$@" .
    exec "$CREWLEAD_HOME/lib/install.sh" "$@"
    ;;

  check)
    repo="$(cd "$(repo_of "$@")" && git rev-parse --show-toplevel)"
    cd "$repo"
    have="$(installed_version .)"
    if [[ -z "$have" ]]; then echo "not installed — run: crewlead init"; exit 1; fi
    problems=0
    say()  { echo "  $1"; }
    flag() { echo "  ! $1"; problems=$((problems + 1)); }
    echo "crewlead in $repo"
    if [[ "$have" == "$VERSION" ]]; then say "version v$have (current)"; else flag "version v$have — v$VERSION is available: crewlead update"; fi
    cfg=.ai/project.yml
    platform="$(sed -n 's/^platform:[[:space:]]*\([a-z]*\).*/\1/p' "$cfg" 2>/dev/null | head -1)"
    if [[ -n "$platform" ]]; then say "platform $platform"; else flag "platform unknown: crewlead update --platform github|gitlab"; fi
    if grep -qE "Generated by (crewlead|ai-dev-flow)" AGENTS.md 2>/dev/null; then say "AGENTS.md generated by crewlead"
    else flag "AGENTS.md is not crewlead's — the flow's rules are not loaded (run the project-setup skill)"; fi
    empty=()
    for f in product tech structure; do
      cmp -s "$CREWLEAD_HOME/core/templates/steering/$f.md" ".ai/steering/$f.md" && empty+=("$f.md")
    done
    if (( ${#empty[@]} )); then flag "steering still empty: ${empty[*]} (run the project-setup skill)"; else say "steering filled in"; fi
    if grep -q 'your-lead-login' "$cfg" 2>/dev/null; then flag "approvers is still the example"; fi
    if [[ "$platform" == gitlab ]] && ! grep -qs 'ai-guard.gitlab-ci.yml' .gitlab-ci.yml; then
      flag "the guard is not in .gitlab-ci.yml (include: .ai/flow/ci/ai-guard.gitlab-ci.yml)"
    fi
    if out="$(.ai/flow/check-drift.sh 2>&1)"; then say "$out"; else flag "drift:"; sed 's/^/      /' <<<"$out"; fi
    # project.yml is written once, so settings added later (ci_run, 0.5.2) stay
    # empty on older installs. A hint, not a problem: empty is a valid choice.
    yml_val() { sed -n "s/^$1:[[:space:]]*//p" | head -1 | sed 's/[[:space:]]*#.*//; s/^"\(.*\)"$/\1/; s/^'"'"'\(.*\)'"'"'$/\1/'; }
    if [[ -z "$(yml_val ci_run < "$cfg" 2>/dev/null)" ]]; then
      ci_det="$(PLATFORM="$platform" "$CREWLEAD_HOME/core/setup/detect-project.sh" . 2>/dev/null | yml_val ci_run || true)"
      [[ -n "$ci_det" ]] && say "hint: ci_run is empty — this repo can start CI before a PR exists; add to $cfg: ci_run: $ci_det"
    fi
    (( problems == 0 )) && echo "ok" || { echo "$problems to fix"; exit 1; }
    ;;

  version|--version|-v) echo "crewlead v$VERSION — $CREWLEAD_HOME" ;;
  help|--help|-h) usage ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
