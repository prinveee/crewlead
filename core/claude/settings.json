{
  "permissions": {
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --no-verify:*)",
      "Bash(ALLOW_PUSH_TO_MAIN=1:*)",
      "Bash(ALLOW_FORCE_PUSH=1:*)",
      "Bash(gh pr merge:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(gh *allow-immutable-edit*)",
      "Bash(gh *allow-test-skip*)",
      "Bash(gh *allow-test-removal*)",
      "Bash(glab *allow-immutable-edit*)",
      "Bash(glab *allow-test-skip*)",
      "Bash(glab *allow-test-removal*)",
      "Bash(gh *--remove-label*needs-lead-review*)",
      "Bash(glab *--unlabel*needs-lead-review*)"
    ]
  }
}
